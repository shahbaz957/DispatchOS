# Copy to .env when Nest apps start reading config.
# These URLs are for apps running on the host (not inside Docker).

# Postgres (one database server per service)
ORDER_DATABASE_URL=postgresql://order:order@localhost:5433/order_db?schema=public
DISPATCH_DATABASE_URL=postgresql://dispatch:dispatch@localhost:5434/dispatch_db?schema=public
TRACKING_DATABASE_URL=postgresql://tracking:tracking@localhost:5435/tracking_db?schema=public
DRIVER_DATABASE_URL=postgresql://driver:driver@localhost:5436/driver_db?schema=public

# Shared Redis (driver geo + locks)
REDIS_HOST=localhost
REDIS_PORT=6379

# Shared Kafka (apps on the host use 9092; containers would use kafka:19092)
KAFKA_BROKERS=localhost:9092

# Order service
ORDER_HTTP_PORT=3001
ORDER_SERVICE_URL=http://127.0.0.1:3001

# Dispatch service
DISPATCH_HTTP_PORT=3002
DISPATCH_SERVICE_URL=http://127.0.0.1:3002

# Tracking service
TRACKING_HTTP_PORT=3003
TRACKING_SERVICE_URL=http://127.0.0.1:3003

# Driver service
DRIVER_HTTP_PORT=3004
DRIVER_SERVICE_URL=http://127.0.0.1:3004

# API gateway (3010 avoids common port-3000 conflicts)
API_GATEWAY_PORT=3010
