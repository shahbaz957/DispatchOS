generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("ORDER_DATABASE_URL")
}

enum OrderStatus {
  PENDING_DISPATCH
  OFFERED
  ASSIGNED
  COMPLETED
  CANCELLED
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  merchantId       String      @map("merchant_id")
  clientOrderId    String?     @map("client_order_id")
  status           OrderStatus @default(PENDING_DISPATCH)
  latitude         Float
  longitude        Float
  assignedDriverId String?     @map("assigned_driver_id")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([merchantId, clientOrderId], name: "merchant_client_order_id")
  @@map("orders")
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model Outbox {
  id          String       @id @default(uuid()) @db.Uuid
  aggregateId String       @map("aggregate_id")
  eventType   String       @map("event_type")
  payload     Json
  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0) @map("retry_count")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("outbox")
}
